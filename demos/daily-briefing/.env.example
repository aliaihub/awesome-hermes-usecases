# Literal values only. Quotes are supported; shell expressions are not expanded.
HERMES_PROFILE=briefing-demo
BRIEFING_NAME="Morning brief"
BRIEFING_SCHEDULE="0 8 * * *"
# Optional. Leave empty when your profile already has a working search backend.
FIRECRAWL_API_KEY=
# Required only by setup-telegram.sh. Configure this profile's Telegram gateway first.
# Positive ID for a DM, negative ID for a group/channel.
TELEGRAM_CHAT_ID=
